## Backup Vault ##
# Append to opencloud-compose's .env, and add the add-on to COMPOSE_FILE:
#
#   COMPOSE_FILE=docker-compose.yml:...:traefik/opencloud.yml:backup/backup.yml:traefik/backup.yml
#
# or, with your own proxy instead of Traefik:
#
#   COMPOSE_FILE=docker-compose.yml:...:external-proxy/opencloud.yml:backup/backup.yml:external-proxy/backup.yml
#
# Single-quote every value: a key can contain characters Compose would
# otherwise read, and the state Space id contains a `$`.

# OpenCloud's service account, from OpenCloud's generated config (the
# `service_account_id` and `service_account_secret` in opencloud.yaml).
BACKUP_OC_SERVICE_ACCOUNT_ID=
BACKUP_OC_SERVICE_ACCOUNT_SECRET=

# The two custody keys: base64 of 32 random bytes each, two different keys.
# Generate each with: openssl rand -base64 32
# Losing them loses unattended backups, not the backups themselves: every
# user's Recovery Key still opens their snapshots.
BACKUP_SRW_KEY=
BACKUP_TW_KEY=

# The Space the service keeps its own state in. Printed once by
#   docker compose run --rm backupd provision-state-space
# Keep it single-quoted.
BACKUP_STATE_SPACE_ID=

# The zone schedules are read in, such as Europe/Berlin.
#BACKUP_TZ=UTC

# A directory with the certificate of your own CA, when OpenCloud's
# certificate (local certificates) or a backup destination's comes from one.
# Its files are trusted in addition to the public CAs.
#BACKUP_CA_DIR=./backup/ca

# Memory limit of the service, and the part of it that is kopia's per-run
# cache in /tmp. Raise both together for large Spaces.
#BACKUP_MEM_LIMIT=512m
#BACKUP_TMP_SIZE=256m

# external-proxy/backup.yml: the localhost port your proxy routes
# /backup/api to.
#BACKUP_PORT=9280

# Operator notifications by email (optional). They never name a Space.
#BACKUP_NOTIFY_EMAIL=
#BACKUP_SMTP_HOST=
#BACKUP_SMTP_PORT=587
#BACKUP_SMTP_USERNAME=
#BACKUP_SMTP_PASSWORD=
#BACKUP_SMTP_FROM=

# Another registry or version than the release this add-on came with.
#BACKUP_DOCKER_IMAGE=ghcr.io/knoppiks/opencloud-backupd
#BACKUP_WEB_DOCKER_IMAGE=ghcr.io/knoppiks/opencloud-backup-vault-web
#BACKUP_VERSION=
