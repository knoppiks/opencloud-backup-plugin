# The backup service's settings that are not secrets, for the ConfigMap
# opencloud-backup-env (kustomization.yaml). The Deployment and the operator
# CronJobs read them all. Your overlay sets the REPLACE_ME values in its own
# backupd.env (overlays/example); every REPLACE_ME left is REFUSED AT
# STARTUP. Every variable, its default and what it does is in
# docs/reference/environment-backupd.md.
#
# A line `# NAME=value` is an optional setting: copy it into the overlay's
# file to use it.

# --- Route ------------------------------------------------------------------

# The path prefix the Ingress routes to this service. The web extension shares
# OpenCloud's origin (it has to: there is no CORS here, by design), so
# `/api/v1/` would be a namespace shared with OpenCloud's own. The prefix keeps
# them apart, and the extension's apiPath must match it. The health probes stay
# at the root either way: the kubelet reaches them on the pod, not through the
# Ingress.
BACKUPD_BASE_PATH=/backup

# --- Sign-in ----------------------------------------------------------------

# The backend validates OpenCloud IdP bearer tokens (JWKS discovery from the
# issuer, retried in the background: an IdP that is not up yet answers 503 on
# authenticated routes instead of preventing startup).
#
# OIDC_AUDIENCE is REQUIRED whenever OIDC_ISSUER is set: one OpenCloud issuer
# mints tokens for several clients, and without it a token issued for any of
# them is accepted here. With OpenCloud's built-in IdP the issuer is
# OpenCloud's own URL and the browser's client id is `web`.
OIDC_ISSUER=https://REPLACE_ME_WITH_THE_OPENCLOUD_URL
OIDC_AUDIENCE=REPLACE_ME_WITH_THE_OIDC_CLIENT_ID

# Admin detection (decisions.md #13). Preferred: graph appRoleAssignments
# through OC_BASE_URL; OC_ADMIN_APP_ROLE_ID defaults to the 7.2–8.1 Admin role
# id and only needs overriding on other builds. The fallback is
# ADMIN_SUBJECT_ALLOWLIST: comma-separated OpenCloud user ids (as its user
# management shows them), NOT OIDC subjects, despite the name. It WINS when
# both are set, silently disabling graph detection: leave it unset unless the
# graph route is unavailable.
#
# OC_BASE_URL is REQUIRED with OIDC_ISSUER: the token's `sub` is not the
# OpenCloud user id, so every caller's id is read from graph /me. It also backs
# group-grant resolution (decisions.md #20): without it, a Space shared with a
# group answers 503 for the members who reach it through that group.
OC_BASE_URL=https://REPLACE_ME_WITH_THE_OPENCLOUD_URL
# OC_ADMIN_APP_ROLE_ID=71881883-1768-46bd-a24d-a356a2afdf7f
# ADMIN_SUBJECT_ALLOWLIST=

# --- OpenCloud's CS3 interface (decisions.md #11) ---------------------------

# OpenCloud binds its gateway to 127.0.0.1:9142 by default. Set its
# OC_GATEWAY_GRPC_ADDR to 0.0.0.0:9142 and publish the port on a Service for
# this address to resolve. Plaintext gRPC, no TLS option: keep it
# on the cluster network (the NetworkPolicy allows it to OpenCloud's
# namespace only).
CS3_GATEWAY_ADDR=opencloud-gateway:9142
# OpenCloud 7.5 and later: where the storage provider's data server is
# reachable, scheme and host only. 7.5 hands CS3 clients that server's own
# address (http://localhost:9158/data by default) instead of the public data
# gateway. Set STORAGE_USERS_HTTP_ADDR=0.0.0.0:9158 on OpenCloud and publish
# the port like the gateway's. The path OpenCloud returns is kept. Plaintext,
# token-checked: cluster network only. Safe to keep set on 7.4 and earlier.
CS3_DATA_SERVER_URL=http://opencloud-gateway:9158

# --- Durable state (decisions.md #16) ---------------------------------------

# The Space the service keeps its own memory in: schedules, run history,
# wrapped key envelopes, target records. NO END USER may be a member of it;
# the service checks this at startup and REFUSES TO START against a personal
# Space or one with any member grant. The CronJob
# opencloud-backup-provision-state-space creates it and prints its id
# (deploy/kustomize/README.md). REQUIRED: without it everything would live in
# memory and be lost on the next restart.
STATE_SPACE_ID=REPLACE_ME_WITH_THE_STATE_SPACE_ID
# STATE_PREFIX=.backup-service-state

# --- Schedules --------------------------------------------------------------

# The container's timezone and, by default, the one schedules are read in:
# "nightly at 02:30" means the household's night. Set it to the household's
# zone; unset means UTC, and 02:30 UTC in Berlin is 03:30 or 04:30, quietly,
# and differently in summer.
TZ=UTC
# SCHEDULE_TIMEZONE=Europe/Berlin      schedules only, when logs stay in UTC
# SCHEDULER_MAX_CONCURRENT=2           simultaneous scheduled runs
# JOB_HISTORY_DAYS=365                 finished runs and their notifications
# PRUNE_INTERVAL_HOURS=24              how often retention is enforced

# --- Pipeline tuning (optional) ---------------------------------------------

# BACKUP_PARALLELISM=4                 files hashed/uploaded at once (0 = per CPU)
# BACKUP_UPLOAD_BYTES_PER_SECOND=0     bandwidth cap towards the target
# BACKUP_DOWNLOAD_BYTES_PER_SECOND=0   (0 = unlimited)

# --- Operator notifications (optional, decisions.md #15) --------------------

# Email for OPERATOR events, which never name a Space or a user. The password
# is a Secret (deployment-backupd.yaml). Without these, notifications are
# recorded and logged only.
# NOTIFY_OPERATOR_EMAIL=admin@example.org
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=backup@example.org
# SMTP_USERNAME=backup
