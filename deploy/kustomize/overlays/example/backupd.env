# Your values for the base's backupd.env, which documents each of them and
# offers the optional ones. Every REPLACE_ME left is refused at startup.
#
# With OpenCloud's built-in IdP, OIDC_ISSUER and OC_BASE_URL are OpenCloud's
# URL and OIDC_AUDIENCE is `web`.
OIDC_ISSUER=https://REPLACE_ME_WITH_THE_OPENCLOUD_URL
OIDC_AUDIENCE=REPLACE_ME_WITH_THE_OIDC_CLIENT_ID
OC_BASE_URL=https://REPLACE_ME_WITH_THE_OPENCLOUD_URL

# OpenCloud's gateway and data server, as a Service in its namespace exposes
# them (README.md, "Deployment: step by step", step 1).
CS3_GATEWAY_ADDR=REPLACE_ME_WITH_THE_OPENCLOUD_SERVICE:9142
CS3_DATA_SERVER_URL=http://REPLACE_ME_WITH_THE_OPENCLOUD_SERVICE:9158

# Printed by the CronJob opencloud-backup-provision-state-space; run it once
# everything above is set.
STATE_SPACE_ID=REPLACE_ME_WITH_THE_STATE_SPACE_ID

# The household's timezone, for schedules.
TZ=UTC
