# The opencloud-compose commit the OpenCloud fixture is built from (#158).
# up.sh fetches exactly this commit; git checks it is that commit. Renovate
# moves it to the head of `main`, and the pull request runs every OpenCloud
# leg against the new commit. The canary uses `main` itself
# (OPENCLOUD_COMPOSE_REF=main).
# renovate: datasource=git-refs depName=https://github.com/opencloud-eu/opencloud-compose
OPENCLOUD_COMPOSE_COMMIT=91911a5883b9e9baf15416a0d62d751c647f1b1b
