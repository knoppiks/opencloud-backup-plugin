# Keep the build context to what the build actually needs: the module and the
# Go sources. Everything else is either irrelevant, large, or must never be
# copied into an image.

# The fixture directories hold OpenCloud's generated config — SECRETS — plus its
# data and loaded apps. They are gitignored; they must not reach a build context
# either.
test/fixtures/opencloud/config/
test/fixtures/opencloud/data/
test/fixtures/opencloud/apps/
test/fixtures/opencloud/fixture.env

# Build output and local state, at any depth.
**/dist/
**/node_modules/
tmp/
.git/
.idea/

# Not part of the service. The web extension has its own image
# (web/Dockerfile, with web/Dockerfile.dockerignore).
web/
.agents/
deploy/
docker-compose.dev.yml
Dockerfile
.dockerignore
