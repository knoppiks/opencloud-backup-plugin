{
  "name": "opencloud-backup-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backup Vault — OpenCloud Web extension for opencloud-backup-plugin",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "vectors": "UPDATE_BROWSER_VECTORS=1 vitest run browservectors"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@opencloud-eu/extension-sdk": "7.2.0",
    "@opencloud-eu/web-client": "7.2.0",
    "@opencloud-eu/web-pkg": "7.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue": "3.5.43",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.11",
    "vue3-gettext": "4.0.1"
  }
}
