{
  "name": "opencloud-backup-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backup Vault — OpenCloud Web extension for opencloud-backup-plugin",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e",
    "vectors": "UPDATE_BROWSER_VECTORS=1 vitest run browservectors",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "hash-wasm": "4.13.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@opencloud-eu/extension-sdk": "8.1.0",
    "@opencloud-eu/web-client": "8.1.0",
    "@opencloud-eu/web-pkg": "8.1.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-router": "5.5.1",
    "vue-tsc": "3.3.14",
    "vue3-gettext": "4.0.1"
  }
}
